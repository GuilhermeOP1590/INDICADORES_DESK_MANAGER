# Chave de API do Operador e Chave de API do Ambiente — DeskManager > Operadores > aba API
DESK_OPERATOR_KEY=
DESK_ENVIRONMENT_KEY=
DESK_API_BASE_URL=https://api.desk.ms
PORT=3001

# Nesta máquina, o Kaspersky faz inspeção HTTPS local e o Node.js não confia
# no certificado raiz dele por padrão (curl/navegador confiam via Windows,
# mas o Node usa sua própria lista de CAs). Sem isso, chamadas à API do
# DeskManager falham com SELF_SIGNED_CERT_IN_CHAIN. Definido como variável
# de ambiente de usuário permanente (não precisa repetir manualmente em
# terminais novos depois de reiniciar o VS Code):
#   NODE_EXTRA_CA_CERTS=C:\Users\guilherme.pereira\AppData\Local\corporate-ca\corporate-ca-bundle.pem
